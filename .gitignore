# Build outputs and editor scratch. Everything else in this repo is tracked.
nim.cfg
nimcache/
*.exe
*.pdb
*.ilk
*.out
out/
tmp/
dist/
node_modules/
replay-viewer/dist/
# ROOT-ANCHORED: the two built binaries, not the src/minecraft/ package
# (an unanchored `minecraft` line matches ANY path component of that name
# and silently un-tracks the whole sim).
/minecraft
/minecraft-player
*.replay
*.bitreplay
# ...but the committed replay fixtures ARE the wasm smoke's evidence.
!tests/fixtures/*.replay
.DS_Store
